# Variables de entorno del backend (nunca subir el .env real a Git)
# En Railway/Render se configuran estas mismas variables en el panel.

# Postgres en Neon (ya la tenés)
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/nombre_bd

# Hash bcrypt de la contraseña del admin (ya lo tenés)
ADMIN_PASSWORD_HASH=$2b$10$....

# En producción: dominio donde queda subido el front (para cerrar CORS).
# Ej: https://karumapu.com  o con www: https://www.karumapu.com
FRONTEND_URL=

# El puerto lo asigna la plataforma (en local usa 3001 solo)
